msgstr "Mesedez, hautatu erro (/) partizioa."

#: usr/lib/live-installer/main.py:1231
msgid ""
"A root partition is needed to install Linux Mint on.\n"
"\n"
" - Mount point: /\n"
" - Recommended size: 30GB\n"
" - Recommended filesystem format: ext4\n"
msgstr ""
"Linux Mint instalatzeko root partizioa behar da.\n"
"\n"
" - Muntatze-puntua: /\n"
" - Gomendatutako tamaina: 30 GB\n"
" - Gomendatutako fitxategi-sistemaren formatua: ext4\n"

#: usr/lib/live-installer/main.py:1249
#, python-format
msgid ""
"%s is not an EFI System Partition. Please edit the partition type or flags, "
"or select another partition."
msgstr ""
"%s ez da EFI sistema-partizio bat. Editatu partizio mota edo banderak, edo "
"hautatu beste partizio bat."

#: usr/lib/live-installer/main.py:1252
#, python-format
msgid "The EFI partition (%s) is too small. It must be at least 35MB."
msgstr "EFI partizioa (%s) txikiegia da. Gutxienez 35MB izan behar ditu."

#: usr/lib/live-installer/main.py:1259
#, python-format
msgid "The EFI partition (%s) must be formatted as vfat."
msgstr "EFI partizioak (%s) vfat formatua izan behar du."

